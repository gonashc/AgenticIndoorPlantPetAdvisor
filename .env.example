APP_ENV=local
APP_NAME=Indoor Plant and Pet Advisor API
API_VERSION=v1
LOG_LEVEL=INFO
OPENAPI_ENABLED=true

# Google Cloud IAP protects the single deployed environment. For direct Cloud
# Run IAP, use /projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME.
# Keep disabled only for local development and tests.
AUTH_MODE=disabled
IAP_AUDIENCE=
ENABLED_CATEGORIES=PLANT,DOG
WEB_DIST_DIR=/app/web

# Use `memory` for unit tests, `url` for a local PostgreSQL instance, or
# `cloud_sql` for Google Cloud SQL through the Python Connector.
DATABASE_MODE=memory
DATABASE_URL=postgresql+asyncpg://advisor:advisor@127.0.0.1:5432/advisor
MIGRATION_DATABASE_URL=postgresql+psycopg://advisor:advisor@127.0.0.1:5432/advisor

# Google Cloud SQL runtime connection settings.
INSTANCE_CONNECTION_NAME=project-id:us-east1:advisor-postgres
DB_USER=advisor-api
DB_NAME=advisor
# Leave DB_PASSWORD unset when automatic IAM database authentication is enabled.
DB_PASSWORD=
CLOUD_SQL_ENABLE_IAM_AUTH=true
CLOUD_SQL_IP_TYPE=PRIVATE
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# LangSmith observability. Store real values in an ignored .env file or the
# deployment secret manager.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=advisor-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Required only when the API key can access multiple LangSmith workspaces.
LANGSMITH_WORKSPACE_ID=
# Avoid recording potentially sensitive recommendation inputs and outputs by default.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Approved-content hybrid retrieval. The Pinecone index must be a dense vector
# index using dotproduct so each record can also carry sparse values.
RETRIEVAL_MODE=disabled
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_DIMENSION=512
PINECONE_INDEX_METRIC=dotproduct
PINECONE_NAMESPACE=knowledge-candidate-v1
PINECONE_DENSE_MODEL=llama-text-embed-v2
PINECONE_SPARSE_MODEL=pinecone-sparse-english-v0
PINECONE_RERANK_MODEL=bge-reranker-v2-m3
PINECONE_HYBRID_ALPHA=0.65
PINECONE_TIMEOUT_SECONDS=10

# Evidence-grounded structured explanations. Keep deterministic until the
# LangSmith quality gate passes; a model may never change safety or ranking.
EXPLANATION_MODE=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2

# Live data is a separate, non-indexed MCP path. Only these two narrowly scoped
# endpoints are used by the first release; tool names are fixed in application code.
MCP_MODE=disabled
MCP_AUTH_MODE=none
MCP_PLACES_URL=
MCP_PLACES_AUDIENCE=
MCP_ADOPTION_URL=
MCP_ADOPTION_AUDIENCE=
MCP_TIMEOUT_SECONDS=8

# Private plant-location MCP service. The API key belongs in Secret Manager in GCP.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_URL=https://places.googleapis.com/v1/places:searchText
GOOGLE_PLACES_TIMEOUT_SECONDS=5
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
