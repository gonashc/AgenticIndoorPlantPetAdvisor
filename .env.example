APP_ENV=local
APP_NAME=Indoor Plant and Pet Advisor API
API_VERSION=v1
LOG_LEVEL=INFO
OPENAPI_ENABLED=true

# Use `memory` for unit tests, `url` for a local PostgreSQL instance, or
# `cloud_sql` for Google Cloud SQL through the Python Connector.
DATABASE_MODE=memory
DATABASE_URL=postgresql+asyncpg://advisor:advisor@127.0.0.1:5432/advisor
MIGRATION_DATABASE_URL=postgresql+psycopg://advisor:advisor@127.0.0.1:5432/advisor

# Google Cloud SQL runtime connection settings.
INSTANCE_CONNECTION_NAME=project-id:us-east1:advisor-postgres
DB_USER=advisor-api
DB_NAME=advisor
# Leave DB_PASSWORD unset when automatic IAM database authentication is enabled.
DB_PASSWORD=
CLOUD_SQL_ENABLE_IAM_AUTH=true
CLOUD_SQL_IP_TYPE=PRIVATE
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# LangSmith observability. Store real values in an ignored .env file or the
# deployment secret manager.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=advisor-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Required only when the API key can access multiple LangSmith workspaces.
LANGSMITH_WORKSPACE_ID=
# Avoid recording potentially sensitive recommendation inputs and outputs by default.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Provider credentials intentionally belong to Engineer 4's integration layer.
# Retrieval and cache configuration belong to Engineers 3 and 4.
